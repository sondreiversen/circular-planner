DATABASE_URL=postgresql://localhost:5432/circular_planner
# Generate with: openssl rand -hex 32
# JWT_SECRET=
PORT=3000
# Set to false for any publicly reachable instance. Default true only for private/LAN deployments.
ALLOW_REGISTRATION=true
# Controls the Secure flag on the cp_token cookie: "auto" (default, Secure when
# TLS is configured or TRUST_PROXY=true), "true", or "false".
# COOKIE_SECURE=auto
